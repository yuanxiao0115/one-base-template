{
  "name": "@one-base-template/app-starter",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "registry": "http://artifact.nc.rdcloud.4c.hq.cmcc/artifactory/api/npm/one-package/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-public-package.mjs app-starter",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint ."
  }
}
