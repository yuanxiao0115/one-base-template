    "vite-plus": "catalog:"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "qs": "^6.14.1"
  },
  "peerDependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2"
  }
