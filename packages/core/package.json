  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-public-package.mjs core",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint .",
    "test": "vp test",
    "test:run": "vp test run"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@types/qs": "^6.14.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.10",
