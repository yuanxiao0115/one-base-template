{
  "name": "@one-base-template/tag",
  "version": "0.1.1",
  "description": "One Tag Component - 标签页管理组件（workspace）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "registry": "http://artifact.nc.rdcloud.4c.hq.cmcc/artifactory/api/npm/one-package/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store-entry.d.ts",
      "import": "./dist/store-entry.js",
      "default": "./dist/store-entry.js"
    },
    "./style": "./dist/style.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-public-package.mjs tag",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vp lint ."
  },
  "keywords": [
    "vue",
    "vue3",
    "component",
    "tag",
    "tabs",
    "ui"
  ],
  "author": "One Team",
  "license": "MIT",
  "peerDependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2"
  },
  "dependencies": {
    "@iconify-icons/ep": "^1.2.0",
    "@iconify-icons/ri": "^1.2.0",
    "@iconify/vue": "^4.1.2",
    "@vueuse/core": "^10.7.0",
    "mitt": "^3.0.1"
  }
}
