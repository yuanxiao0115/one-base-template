{
  "name": "@one-base-template/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "registry": "http://artifact.nc.rdcloud.4c.hq.cmcc/artifactory/api/npm/one-package/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./obtable": {
      "types": "./dist/obtable.d.ts",
      "import": "./dist/obtable.js",
      "default": "./dist/obtable.js"
    },
    "./vxe": {
      "types": "./dist/vxe.d.ts",
      "import": "./dist/vxe.js",
      "default": "./dist/vxe.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js",
      "default": "./dist/lite.js"
    },
    "./lite-auth": {
      "types": "./dist/lite-auth.d.ts",
      "import": "./dist/lite-auth.js",
      "default": "./dist/lite-auth.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js",
      "default": "./dist/shell.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-public-package.mjs ui",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vp lint .",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@iconify-json/ep": "^1.2.2",
    "@iconify-json/ri": "^1.2.7",
    "@iconify/vue": "^4.3.0",
    "@one-base-template/core": "workspace:^",
    "@one-base-template/tag": "workspace:^",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pdf": "^2.0.10",
    "@vue-office/pptx": "^1.0.1",
    "gm-crypto": "^0.1.12",
    "ofdview-vue3": "^1.0.31",
    "parser_x.js": "^1.1.80",
    "sortablejs": "^1.15.7",
    "vxe-pc-ui": "4.12.36",
    "vxe-table": "4.17.48"
  },
  "peerDependencies": {
    "element-plus": "^2.13.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@vitest/coverage-v8": "^4.1.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.10",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
