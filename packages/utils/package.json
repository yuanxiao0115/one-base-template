  },
  "peerDependencies": {
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.3.3",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.10",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
